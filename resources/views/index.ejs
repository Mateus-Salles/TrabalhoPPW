<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daily Diary</title>
    <link rel="stylesheet" href="css/styles.css">
    <script src="js/index.js" defer></script>
    <script src="https://kit.fontawesome.com/2c6c07d186.js" crossorigin="anonymous"></script>
    <img src="img/lettering-head.png" id="header-image">
</head>
<body>
    <!-- Previous Button -->
    <button id="prev-btn">
        <i class="fas fa-arrow-circle-left"></i>
    </button>


    <!-- Book -->
    <div id="book" class="book">
        <!-- Paper 1 -->

        <div class="paper">
            <div class="front">
                <div class="front-content"></div>
            </div>
            <div class="back">
                <div class="back-content">
                    <%= user.username %>
                    <button>Account</button>
                </div>
            </div>
        </div>
            
        <% if (!pages.length) { %>
            <div class="paper">
                <%- include('components/pages/front', { page: { body: null, id: null } }) %>
                <%- include('components/pages/back', { page: { body: null, id: null } }) %>
            </div>
        <% } %>

        <% pages.forEach((page, index, pages) => { %>
            <% if (index % 2 === 0) { %>
                <div class="paper">
                    <%- include('components/pages/front', { page }) %>
            <% } else { %>
                    <%- include('components/pages/back', { page }) %>
                </div>
            <% } %>
        <% }) %>

        <% if (pages.length % 2 !== 0) { %>
                <%- include('components/pages/back', { page: { body: null, id: null } }) %>
            </div>
        <% } %>
    </div>

    <!-- Next Button -->
    <button id="next-btn">
        <i class="fas fa-arrow-circle-right"></i>
    </button>
    <footer>
        <button id="save-btn">
            <i class="fa-regular fa-circle-check"></i>
        </button>
        
        <button id="delete-btn">
            <i class="fa-solid fa-trash-can"></i>
        </button>
    </footer>
</body>
</html>